{
  "servers": {
    "rust-analyzer": {
      "command": "rust-analyzer",
      "fileTypes": [
        ".rs"
      ],
      "rootMarkers": [
        "src-tauri/Cargo.toml"
      ],
      "settings": {
        "rust-analyzer": {
          "linkedProjects": [
            "src-tauri/Cargo.toml"
          ],
          "cargo": {
            "targetDir": "src-tauri/target"
          },
          "check": {
            "command": "check"
          }
        }
      },
      "capabilities": {
        "flycheck": true,
        "ssr": true,
        "expandMacro": true,
        "runnables": true,
        "relatedTests": true
      },
      "warmupTimeoutMs": 120000
    }
  }
}
