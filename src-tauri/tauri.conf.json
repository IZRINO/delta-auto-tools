{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "delta-auto-tools",
  "version": "0.17.0",
  "identifier": "org.izrino.delta-auto-tools",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "三角洲行动工具",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwQzQ5Q0Y0MUYzMDg2OUQKUldTZGhqQWY5SnpFRUVja2lTTm9weVp4YnhrcnlFOVlCT25nc1hrTmo4ZVQ3OXA4dUNhcyt5ZEkK",
      "endpoints": [
        "https://github.com/IZRINO/delta-auto-tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
