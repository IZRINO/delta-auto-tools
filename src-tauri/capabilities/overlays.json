{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlays",
  "description": "Local display, position and selection overlay capability",
  "windows": [
    "morse-overlay",
    "timer-display",
    "timer-display-*",
    "timer-position",
    "timer-position-*",
    "counter-display",
    "counter-display-*",
    "counter-position",
    "counter-position-*",
    "rapidfire-display",
    "rapidfire-display-*",
    "rapidfire-position",
    "rapidfire-position-*",
    "recognition-overlay",
    "recognition-overlay-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-show"
  ]
}
